{
  "name": "candleviewer",
  "private": true,
  "description": "CandleViewer monorepo root — pnpm workspace + Turborepo task graph.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "build": "turbo run build",
    "size": "turbo run size",
    "generate": "turbo run generate",
    "arch": "node scripts/run-arch-checks.mjs",
    "security": "python tools/ci/run_security_local.py",
    "verify": "node scripts/run-verify-gate.mjs",
    "check:verify-gate-list": "node scripts/check-verify-gate-list.mjs",
    "check:agents-commands": "node scripts/check-agents-commands.mjs",
    "check:branch-name": "node scripts/check-branch-name.mjs",
    "gate:threshold-guard": "python tools/ci/quality_gates.py",
    "gate:flaky-quarantine": "python tools/ci/flaky_quarantine_report.py --repo-root .",
    "gate:bundle-size-regression": "node scripts/check-bundle-size-regression.mjs",
    "gate:negative-tests": "node scripts/gate-negative-tests.mjs",
    "test:toolchain": "python -m pytest tests/toolchain -q && python -m tests.toolchain.pack",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css}": [
      "prettier --write"
    ],
    "services/api/**/*.py": [
      "uv run --project services/api ruff check --fix --force-exclude",
      "uv run --project services/api black --force-exclude '(candleviewer/(api|ws)/_generated/.*)'"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/lint": "^19.6.0",
    "@commitlint/load": "^19.6.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "2.11.7"
  }
}
