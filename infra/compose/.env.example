# infra/compose/.env.example — E02-T08
#
# Copy to infra/compose/.env for local dev (gitignored, never commit real
# values). Every CV_* variable read by services/api/candleviewer/settings.py
# has a safe default here; anything secret-like is CHANGE_ME so
# infra/scripts/bootstrap.sh refuses non-dev profiles until it is replaced
# (E02-X01 threat model, credential-leakage control).

# --- api / CandleViewer settings (settings.py CV_ prefix) -----------------
CV_ENVIRONMENT=demo
CV_FEED=synthetic
CV_BIND_HOST=127.0.0.1
CV_BIND_PORT=8000
CV_PG_DSN=postgresql+asyncpg://cv:CHANGE_ME@postgres:5432/candleviewer
CV_QUESTDB_ILP=questdb:9009
CV_QUESTDB_PG=questdb:8812
CV_QUESTDB_PG_USER=admin
# Must be changed from the QuestDB dev default (`quest`) for environment=live + storage_backend=real.
CV_QUESTDB_PG_PASSWORD=CHANGE_ME
CV_PARQUET_ROOT=/data/parquet

# --- audit lane key (ADR-0037 decision 6) -------------------------------------
# A path, never the key: the host file compose mounts as the api's /run/secrets/cv_audit_lane_key,
# 64 hex digits, mode 0400, owned by uid 10001, one per environment. Empty: /dev/null, which the
# fake backend never reads and a real backend refuses. The name holds no PASSWORD, SECRET or KEY,
# so dast-auth-zap.yml keeps it.
CV_AUDIT_LANE_MAC_SOURCE=

# --- demo host (docker-compose.demo-host.yml, docs/ops/runbooks/demo-host.md) -------
# Read only by that overlay, which refuses every compose command while one of its required names
# is empty: blank means unset. The sensitive ones stay blank, never CHANGE_ME: a CHANGE_ME pepper
# would be accepted as a pepper, and dast-auth-zap.yml fails on a CHANGE_ME it keeps (a name with
# no PASSWORD, SECRET or KEY). `real` on the demo host; the base file never reads it.
CV_STORAGE_BACKEND=
# Confidential (E27 threat model §1.2): the address the exchange sees from the host.
CV_EGRESS_IP=
# A path, never the KEK: the host file compose mounts as the api's /run/secrets/cv_kek (32 raw
# bytes, mode 0400, owned by uid 10001). The KEK itself is never in this file or `environment:`.
CV_KEK_FILE=
CV_KEK_VERSION=1
CV_AUTH_PEPPER=
# 32 bytes of hex each, three different keys.
CV_AUTH_CSRF_KEY_HEX=
CV_AUTH_TOTP_KEY_HEX=
CV_AUTH_RECOVERY_HMAC_KEY_HEX=
# The compose network (cv-internal in docker-compose.yml): the api's healthcheck and the host's
# loopback publish reach it from there, and MeshOnly refuses every other source but loopback.
CV_MESH_CIDRS_CSV=172.28.0.0/24
# Empty admits no browser origin.
CV_ALLOWED_ORIGINS=
# The owner role's DSN (cv_owner), for the migrate one-shot only; api never takes it.
CV_PG_OWNER_DSN=

# --- postgres ---------------------------------------------------------------
POSTGRES_USER=cv
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=candleviewer
POSTGRES_PORT=5432

# --- questdb ------------------------------------------------------------------
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9009
QUESTDB_HTTP_PORT=9000

# --- prometheus ---------------------------------------------------------------
PROMETHEUS_PORT=9090

# --- grafana --------------------------------------------------------------------
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# --- minio (Parquet/cold-tier stand-in) ------------------------------------------
MINIO_ROOT_USER=cvminio
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_BUCKET=candleviewer-parquet

# --- build metadata (injected at image build time, not a secret) ---------------
CV_GIT_SHA=unknown
