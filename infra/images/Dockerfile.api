# infra/images/Dockerfile.api — E02-T08
#
# Multi-stage build for services/api. Builder installs the locked venv with
# uv; the runtime stage copies only the venv + application code, runs as a
# non-root UID, and carries no dev dependencies (ruff/mypy/pytest/etc. never
# reach the runtime layer). See docs/plan/20-architecture.md Sec.5 and the
# E02-X01 threat model (supply-chain / container-escape controls).

# --- builder ---------------------------------------------------------------
FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir "pip==26.2.1" uv==0.4.27

WORKDIR /build
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY services/api/candleviewer ./candleviewer
COPY services/api/README.md ./README.md
RUN uv sync --frozen --no-dev

# --- runtime -----------------------------------------------------------------
FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS runtime

# Apply Debian security fixes published after the pinned digest was cut, so
# already-fixed CVEs never ship; unfixed ones are covered by the weekly rebuild.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The runtime never runs pip, setuptools or wheel (the app venv is built in the builder stage with
# its own locked deps), yet the base image's copies are scanned: setuptools 70.3.0
# (CVE-2025-47273), setuptools 80.x (CVE-2026-59890) and pip's vendored msgpack/urllib3, which lag
# the app lock. Remove them instead of chasing versions, so the image has nothing left to flag.
RUN python -m pip uninstall -y pip setuptools wheel \
    && rm -rf /usr/local/lib/python3.12/site-packages/pip* \
              /usr/local/lib/python3.12/site-packages/setuptools* \
              /usr/local/lib/python3.12/site-packages/pkg_resources \
              /usr/local/lib/python3.12/site-packages/wheel* \
              /usr/local/lib/python3.12/site-packages/_distutils_hack \
              /usr/local/lib/python3.12/ensurepip/_bundled \
              /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 /usr/local/bin/wheel \
              /root/.cache

RUN groupadd --gid 10001 cvapi \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin cvapi

# #2615: the mount point of compose's audit volume (the directory of CV_AUDIT_WAL_PATH). Docker
# copies the owner and mode of a mount point that exists in the image into an empty named volume,
# so the volume starts owned by the runtime user and stays writable under the read-only root
# filesystem; without this line it would be root-owned and the non-root api could not write it.
# 0700 because audit records carry user and session ids and addresses. Only the leaf belongs to
# cvapi; /var/lib/candleviewer stays root-owned.
RUN mkdir -p /var/lib/candleviewer/audit \
    && chown 10001:10001 /var/lib/candleviewer/audit \
    && chmod 0700 /var/lib/candleviewer/audit

WORKDIR /app
COPY --from=builder --chown=10001:10001 /build/.venv /app/.venv
COPY --from=builder --chown=10001:10001 /build/candleviewer /app/candleviewer
# E02-T12: the synthetic feed generator's committed sample fixture
# (CV_FEED=synthetic default). No real fixtures/credentials — see
# packages/fixtures/README.md.
COPY --chown=10001:10001 packages/fixtures/raw/synthetic_sample.jsonl \
    /app/packages/fixtures/raw/synthetic_sample.jsonl

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10001:10001

# Read-only root filesystem at runtime (compose sets `read_only: true` plus an
# explicit writable tmpfs for /tmp); nothing here needs to write to the image.
EXPOSE 8000

# NOTE on B2 (loopback-only): binding 0.0.0.0 *inside* the container's own
# network namespace is required for docker's bridge networking to route the
# published port at all (a container-local 127.0.0.1 bind is unreachable
# even from the docker-proxy). The loopback-only control lives one layer
# out, in docker-compose.yml's explicit `127.0.0.1:<port>:<port>` publish —
# that is what stops the socket being reachable from the LAN/WSL portproxy.
# Launched via candleviewer.server so WS size/queue/compression/concurrency
# limits come from candleviewer.ws.limits (single source, protocol §16.2).
ENTRYPOINT ["python", "-m", "candleviewer.server"]
