{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [],
    "ask": [],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +main:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(curl *bybit.com*)",
      "Bash(curl *bytick.com*)",
      "Bash(wget *bybit.com*)",
      "Bash(wget *bytick.com*)",
      "WebFetch(domain:bybit.com)",
      "WebFetch(domain:api.bybit.com)",
      "WebFetch(domain:api-demo.bybit.com)",
      "WebFetch(domain:api-testnet.bybit.com)",
      "WebFetch(domain:stream.bybit.com)",
      "WebFetch(domain:bytick.com)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/*.key)",
      "Read(./.claude/settings.local.json)",
      "Bash(*settings.local.json*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_edit_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_lint_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
