  "profiles": {
    "A": {
      "title": "Roadmap 5.4 gate: 5 clients x 10 symbols, 1 h",
      "feed": "ten",
      "users": 5,
      "connections": 1,
      "symbols": 10,
      "workspace": "rw",
      "bars_symbols": 7,
      "footprint_symbols": 1,
      "duration_s": 3600,
      "probe": true
    },
    "B": {
      "title": "23 16.4 protocol gate: 8 connections x 40 symbols x full workspace, 1 h",
      "feed": "forty",
      "users": 1,
      "connections": 8,
      "symbols": 40,
      "workspace": "fw",
      "bars_symbols": 7,
      "footprint_symbols": 1,
      "duration_s": 3600,
      "probe": true
    },
    "C": {
      "title": "06 10.1 capacity driver: 5 users x 4 panes on 4 symbols, 30 min",
      "feed": "ten",
      "users": 5,
      "connections": 1,
      "symbols": 4,
      "workspace": "rw",
      "bars_symbols": 4,
      "duration_s": 1800
    },
    "smoke": {
      "base": "A",
      "title": "A shape, short",
      "duration_s": 120,
      "warmup_s": 20,
      "reauth_after_s": 45,
      "probe_every_s": 30
    },
    "W5": {
      "base": "A",
      "title": "A shape without the probe: the W5 phases run on it",
      "probe": false,
      "judge_bandwidth": false
    },
    "selfcheck": {
      "base": "A",
      "title": "A shape with an ASGI send delay inside the fan-out span: budget 6 must fail",
      "duration_s": 600,
      "warmup_s": 60,
      "send_delay_ms": 25,
      "probe": false,
      "expect_fail": "budget6.cv_ws_fanout_seconds.p95"
    }
  },
  "w5": {
    "base": "W5",
    "phases": [
      { "name": "idle", "families": [], "duration_s": 300, "warmup_s": 30 },
      { "name": "mixed-healthy", "rtt_delay_ms": 0, "duration_s": 600, "warmup_s": 60 },
      { "name": "mixed-lagging", "rtt_delay_ms": 300, "duration_s": 600, "warmup_s": 60 },
      { "name": "mixed-saturated", "rtt_delay_ms": 700, "duration_s": 600, "warmup_s": 60 },
      { "name": "book-healthy", "families": ["book"], "duration_s": 300, "warmup_s": 30 },
      {
        "name": "book-saturated",
        "families": ["book"],
        "rtt_delay_ms": 700,
        "duration_s": 300,
        "warmup_s": 30
      },
      { "name": "trades-healthy", "families": ["trades"], "duration_s": 300, "warmup_s": 30 },
      {
        "name": "trades-saturated",
        "families": ["trades"],
        "rtt_delay_ms": 700,
        "duration_s": 300,
