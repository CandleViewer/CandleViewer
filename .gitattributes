# Force LF for cross-platform dev tooling: shebang scripts and git hooks must
# never be checked out with CRLF, or POSIX shebang-stripping (Node/ESM loaders,
# Vite/Vitest, and the shell that runs husky hooks) breaks on Windows checkouts
# even though the committed blob is LF (see PR #1454 review).
* text=auto eol=lf

/scripts/**       text eol=lf
/.husky/**        text eol=lf
*.mjs             text eol=lf
*.cjs             text eol=lf
*.sh              text eol=lf

# Generated protocol contracts (E02-T09) — never hand-edit; regenerate via
# `pnpm --filter @candleviewer/protocol generate` and
# `uv run --project services/api python scripts/generate_protocol_models.py`.
# linguist-generated hides these from PR diffs by default and from GitHub's
# language stats; the header-guard lints still fail a build on a hand-edit.
packages/protocol/src/generated/** linguist-generated=true
docs/plan/ws-schema.json linguist-generated=true
services/api/candleviewer/api/_generated/** linguist-generated=true
services/api/candleviewer/ws/_generated/** linguist-generated=true

# E17-T07: the cv.v1 wire-contract golden is text with LF endings. It is deliberately not marked
# linguist-generated: a change to it is the reviewable act that changes the contract (`--extend` for
# an additive change, a v2 golden for a breaking one), so its diff is shown in a PR.
packages/protocol/wire-contract.v1.golden.json text eol=lf

# Generated artefacts that are byte-compared against their generator in tests
# (tools/rbac/generate.py --check, tools/gen/export_instrument_policy_*.py).
# The generators always emit LF; pin eol=lf explicitly so the checkout can
# never drift to CRLF and make those byte-equality gates platform-dependent.
packages/fixtures/golden/policy/*.json                      text eol=lf linguist-generated=true
services/api/candleviewer/auth/generated_permissions.py    text eol=lf linguist-generated=true
services/api/candleviewer/auth/rbac_seed.json              text eol=lf linguist-generated=true
