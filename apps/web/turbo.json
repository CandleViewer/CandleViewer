{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "env": ["CV_ALLOW_FAULT_INJECTION"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "vitest.config.mjs",
        "vite.config.ts",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.dom.json",
        "$TURBO_ROOT$/packages/config/vitest.preset.mjs",
        "$TURBO_ROOT$/tests/fuzz/ws-frames/**",
        "$TURBO_ROOT$/packages/fixtures/golden/rule-graph/vocabulary/**",
        "$TURBO_ROOT$/docs/design/E36/E36-D05-copy-deck.json",
        "$TURBO_ROOT$/docs/design/E37/E37-D05-copy-deck.jsonl",
        "$TURBO_ROOT$/docs/design/research/e36-rules-in-words.md"
      ]
    },
    "test:cov": {
      "env": ["CV_ALLOW_FAULT_INJECTION"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "vitest.config.mjs",
        "vite.config.ts",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.dom.json",
        "$TURBO_ROOT$/packages/config/vitest.preset.mjs",
        "$TURBO_ROOT$/tests/fuzz/ws-frames/**",
        "$TURBO_ROOT$/packages/fixtures/golden/rule-graph/vocabulary/**",
        "$TURBO_ROOT$/docs/design/E36/E36-D05-copy-deck.json",
        "$TURBO_ROOT$/docs/design/E37/E37-D05-copy-deck.jsonl",
        "$TURBO_ROOT$/docs/design/research/e36-rules-in-words.md"
      ]
    }
  }
}
