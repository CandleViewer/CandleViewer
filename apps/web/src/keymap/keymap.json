{
  "$comment": "Single source of truth for default hotkeys (E49-T04). Validated by scripts/keymap_lint.py.",
  "version": 1,
  "safetyModifierDefault": true,
  "cheatsheetContexts": [
    "Global",
    "Auth",
    "Workspace",
    "Chart",
    "DOM",
    "Ticket",
    "Positions",
    "Replay",
    "Rules"
  ],
  "commands": [
    {
      "id": "global.auth.submit",
      "label": "Submit sign-in",
      "context": "Auth",
      "defaultBinding": "Enter",
      "destructive": false,
      "validWhen": "login form focused",
      "visibleControl": true,
      "screens": ["SCR-001"],
      "allowInEditable": true,
      "shadows": [
        {
          "command": "positions.open_sltp",
          "rationale": "Enter/save is scoped to the focused form or editor; contexts are never co-active"
        },
        {
          "command": "rules.inspect_node",
          "rationale": "Enter/save is scoped to the focused form or editor; contexts are never co-active"
        }
      ]
    },
    {
      "id": "global.palette",
      "label": "Command palette",
      "context": "Global",
      "defaultBinding": "Ctrl+K",
      "destructive": false,
      "validWhen": "always",
      "visibleControl": true,
      "screens": ["SCR-010"],
      "editable": false,
      "editableException": "05 §3.3 rule 3: Ctrl+K is permanently reserved for the command palette, the way back when a user breaks their own keymap; excluded from the remap UI (#305, BQ-7)"
    },
    {
      "id": "global.account_picker",
      "label": "Account picker",
      "context": "Global",
      "defaultBinding": "Ctrl+Shift+A",
      "destructive": false,
      "validWhen": "always",
      "visibleControl": true,
      "screens": ["SCR-010"]
    },
    {
      "id": "global.cheatsheet",
      "label": "Hotkey cheatsheet",
      "context": "Global",
      "defaultBinding": "Ctrl+/",
      "destructive": false,
      "validWhen": "always",
      "visibleControl": true,
      "screens": ["SCR-010"]
    },
    {
      "id": "global.fullscreen",
      "label": "Full-screen workspace",
      "context": "Global",
      "defaultBinding": "F11",
      "destructive": false,
      "validWhen": "always",
      "visibleControl": true,
      "screens": ["SCR-010"],
      "reservedOverride": {
        "rationale": "Deliberate: app-managed full-screen workspace replaces the browser default; Electron maps it to the same action"
      }
    },
    {
      "id": "global.nav_rail",
