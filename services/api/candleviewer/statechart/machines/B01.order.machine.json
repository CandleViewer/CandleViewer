{
  "id": "order",
  "version": 5,
  "strictConfig": true,
  "maxIterations": 500,
  "actionErrorPolicy": "rollback",
  "onUnhandled": "defer",
  "guardErrorPolicy": "raise",
  "strictTargets": true,
  "strict": true,
  "spawnBlockingTimeout": 5000,
  "type": "parallel",
  "context": {
    "order_id": null,
    "order_link_id": null,
    "account_id": null,
    "symbol": null,
    "side": null,
    "qty": "0",
    "filled_qty": "0",
    "leaves_qty": "0",
    "avg_price": null,
    "cum_exec_value": "0",
    "fee_paid": "0",
    "seen_exec_ids": [],
    "last_exchange_update": 0,
    "recon_misses": 0,
    "_fault": null,
    "sl_deadline_us": null,
    "halted_by_kill": false,
    "kill_skip_cancel": false,
    "exchange_order_id": null,
    "price": null,
    "trigger_price": null,
    "take_profit": null,
    "stop_loss": null,
    "reduce_only": false,
    "reject_code": null,
    "needs_lookup": false,
    "amend_terms": null,
    "rate_reservation": null,
    "persisted_state": null,
    "event_seq": null,
    "recon_deadline_us": null,
    "sl_reading": null,
    "outbox": [],
    "discovered": false,
    "recorded_stop": false
  },
  "states": {
    "lifecycle": {
      "initial": "draft",
      "states": {
        "draft": {
          "entry": [
            "persist_event"
          ],
          "on": {
            "VALIDATE": [
              {
                "target": "#order.lifecycle.validated",
                "guard": "passes_all_gates",
                "actions": [
                  "stamp_validated"
                ]
              },
              {
                "target": "#order.lifecycle.rejected",
                "actions": [
                  "set_local_reject"
                ]
              }
            ],
            "DISCOVERED": {
              "target": "#order.lifecycle.untracked",
              "actions": [
                "record_discovered"
              ]
            },
            "MATERIALISED": {
              "target": "#order.lifecycle.submitted",
              "actions": [
                "record_materialised"
              ]
            },
            "KILL": {
              "target": "#order.lifecycle.killed",
              "actions": [
                "skip_kill_cancel"
              ]
            }
          }
        },
        "validated": {
          "entry": [
            "persist_event",
            "reserve_rate_token"
          ],
          "on": {
            "SEND": {
              "target": "#order.lifecycle.submitting"
            },
            "KILL": {
              "target": "#order.lifecycle.killed",
              "actions": [
                "skip_kill_cancel"
              ]
            }
          }
        },
        "submitting": {
          "entry": [
            "persist_event"
          ],
          "invoke": {
            "id": "place",
            "src": "place_order",
            "onDone": [
              {
                "target": "#order.lifecycle.submitted",
                "guard": "ret_code_ok",
                "actions": [
                  "adopt_ack"
                ]
              },
              {
                "target": "#order.lifecycle.held",
                "guard": "is_link_id_mismatch",
                "actions": [
                  "record_mismatch"
                ]
              },
              {
                "target": "#order.lifecycle.submitted",
                "guard": "is_duplicate_link_id_full_match",
                "actions": [
                  "adopt_ack"
                ]
              },
              {
                "target": "#order.lifecycle.unknown",
                "guard": "is_duplicate_link_id",
                "actions": [
                  "mark_needs_lookup",
                  "skip_kill_cancel"
                ]
              },
              {
                "target": "#order.lifecycle.rejected",
                "actions": [
                  "map_reject_code"
                ]
              }
            ],
            "onError": {
              "target": "#order.lifecycle.unknown",
              "actions": [
                "record_transport_fault"
              ]
            }
          },
          "on": {}
        },
        "submitted": {
          "entry": [
            "persist_event"
          ],
          "on": {
            "EXEC": [
              {
                "target": "#order.lifecycle.filled",
                "guard": "exec_new_and_closes",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "exec_new_and_partial",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "actions": [
                  "audit_guard_denied"
                ]
              }
            ],
            "TRIGGERED": {
              "target": "#order.lifecycle.triggered"
            },
            "CANCEL": {
              "target": "#order.lifecycle.cancel_pending"
            },
            "AMEND": {
              "target": "#order.lifecycle.amend_pending",
              "actions": [
                "stage_amend"
              ]
            },
            "EXPIRE": {
              "target": "#order.lifecycle.expired"
            },
            "REMOTE_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_remote_cancel"
              ]
            },
            "MISMATCH": {
              "target": "#order.lifecycle.held",
              "actions": [
                "record_mismatch"
              ]
            },
            "TRANSPORT_FAULT": {
              "target": "#order.lifecycle.unknown"
            },
            "FAULT": {
              "target": "#order.lifecycle.quarantined"
            },
            "TERMS_CHANGED": [
              {
                "target": "#order.lifecycle.submitted",
                "guard": "recorded_terms_changed",
                "reenter": true,
                "actions": [
                  "adopt_terms"
                ]
              },
              {
                "actions": [
                  "audit_terms_refused"
                ]
              }
            ],
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "target": "#order.lifecycle.killed"
              }
            ]
          }
        },
        "triggered": {
          "entry": [
            "persist_event"
          ],
          "on": {
            "EXEC": [
              {
                "target": "#order.lifecycle.filled",
                "guard": "exec_new_and_closes",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "exec_new_and_partial",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "actions": [
                  "audit_guard_denied"
                ]
              }
            ],
            "CANCEL": {
              "target": "#order.lifecycle.cancel_pending"
            },
            "EXPIRE": {
              "target": "#order.lifecycle.expired"
            },
            "REMOTE_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_remote_cancel"
              ]
            },
            "TERMS_CHANGED": [
              {
                "target": "#order.lifecycle.triggered",
                "guard": "recorded_terms_changed",
                "reenter": true,
                "actions": [
                  "adopt_terms"
                ]
              },
              {
                "actions": [
                  "audit_terms_refused"
                ]
              }
            ],
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "target": "#order.lifecycle.killed"
              }
            ]
          }
        },
        "partially_filled": {
          "entry": [
            "persist_event",
            "notify_protection_region"
          ],
          "on": {
            "EXEC": [
              {
                "target": "#order.lifecycle.filled",
                "guard": "exec_new_and_closes",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "exec_new_and_partial",
                "reenter": true,
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "actions": [
                  "audit_guard_denied"
                ]
              }
            ],
            "CANCEL": {
              "target": "#order.lifecycle.cancel_pending"
            },
            "AMEND": {
              "target": "#order.lifecycle.amend_pending",
              "actions": [
                "stage_amend"
              ]
            },
            "FAULT": {
              "target": "#order.lifecycle.quarantined"
            },
            "EXPIRE": {
              "target": "#order.lifecycle.expired"
            },
            "REMOTE_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_remote_cancel"
              ]
            },
            "TERMS_CHANGED": [
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "recorded_terms_changed",
                "reenter": true,
                "actions": [
                  "adopt_terms"
                ]
              },
              {
                "actions": [
                  "audit_terms_refused"
                ]
              }
            ],
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "target": "#order.lifecycle.killed"
              }
            ]
          }
        },
        "cancel_pending": {
          "entry": [
            "persist_event"
          ],
          "invoke": {
            "id": "cancel",
            "src": "cancel_order",
            "onDone": [
              {
                "target": "#order.lifecycle.cancelled",
                "guard": "ret_code_ok",
                "actions": [
                  "adopt_cancel_ack"
                ]
              },
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "has_fills",
                "actions": [
                  "record_cancel_refused"
                ]
              },
              {
                "target": "#order.lifecycle.submitted",
                "actions": [
                  "record_cancel_refused"
                ]
              }
            ],
            "onError": {
              "target": "#order.lifecycle.unknown",
              "actions": [
                "record_transport_fault"
              ]
            }
          },
          "on": {
            "EXEC": [
              {
                "target": "#order.lifecycle.filled",
                "guard": "exec_new_and_closes",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "exec_new_and_partial",
                "actions": [
                  "apply_fill"
                ]
              },
              {
                "actions": [
                  "audit_guard_denied"
                ]
              }
            ],
            "REMOTE_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_remote_cancel"
              ]
            },
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "actions": [
                  "mark_halted_by_kill",
                  "audit_kill_cancel_in_flight"
                ]
              }
            ]
          }
        },
        "amend_pending": {
          "entry": [
            "persist_event"
          ],
          "invoke": {
            "id": "amend",
            "src": "amend_order",
            "onDone": [
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "ret_code_ok_and_has_fills",
                "actions": [
                  "adopt_amend"
                ]
              },
              {
                "target": "#order.lifecycle.submitted",
                "guard": "ret_code_ok",
                "actions": [
                  "adopt_amend"
                ]
              },
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "has_fills",
                "actions": [
                  "keep_prior_order_live",
                  "notify_amend_rejected"
                ]
              },
              {
                "target": "#order.lifecycle.submitted",
                "actions": [
                  "keep_prior_order_live",
                  "notify_amend_rejected"
                ]
              }
            ],
            "onError": {
              "target": "#order.lifecycle.unknown",
              "actions": [
                "record_transport_fault"
              ]
            }
          },
          "on": {
            "AMEND_REJECTED": [
              {
                "target": "#order.lifecycle.partially_filled",
                "guard": "has_fills",
                "actions": [
                  "keep_prior_order_live",
                  "notify_amend_rejected"
                ]
              },
              {
                "target": "#order.lifecycle.submitted",
                "actions": [
                  "keep_prior_order_live",
                  "notify_amend_rejected"
                ]
              }
            ],
            "REMOTE_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_remote_cancel"
              ]
            },
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "target": "#order.lifecycle.killed"
              }
            ]
          }
        },
        "unknown": {
          "entry": [
            "persist_event",
            "raise_unknown_alert",
            "arm_recon_deadline"
          ],
          "on": {
            "RECON_FOUND_LIVE": {
              "target": "#order.lifecycle.submitted",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_PARTIAL": {
              "target": "#order.lifecycle.partially_filled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_FILLED": {
              "target": "#order.lifecycle.filled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_MISS": [
              {
                "target": "#order.lifecycle.rejected",
                "guard": "second_consecutive_miss",
                "actions": [
                  "set_reject_unresolvable"
                ]
              },
              {
                "target": "#order.lifecycle.unknown",
                "reenter": true,
                "actions": [
                  "bump_recon_misses"
                ]
              }
            ],
            "MISMATCH": {
              "target": "#order.lifecycle.held",
              "actions": [
                "record_mismatch"
              ]
            },
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "target": "#order.lifecycle.killed"
              }
            ]
          }
        },
        "quarantined": {
          "entry": [
            "persist_event",
            "raise_critical_alert",
            "request_reconciliation"
          ],
          "tags": [
            "untrusted"
          ],
          "on": {
            "RECON_FOUND_LIVE": {
              "target": "#order.lifecycle.submitted",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_PARTIAL": {
              "target": "#order.lifecycle.partially_filled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_FILLED": {
              "target": "#order.lifecycle.filled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_recon"
              ]
            },
            "MISMATCH": {
              "target": "#order.lifecycle.held",
              "actions": [
                "record_mismatch"
              ]
            },
            "KILL": [
              {
                "guard": "is_recorded_stop",
                "actions": [
                  "audit_kill_spared_recorded_stop"
                ]
              },
              {
                "target": "#order.lifecycle.killed"
              }
            ]
          }
        },
        "untracked": {
          "entry": [
            "persist_event"
          ],
          "on": {
            "ADOPT": [
              {
                "target": "#order.lifecycle.submitted",
                "guard": "adoption_allowed",
                "actions": [
                  "adopt_untracked"
                ]
              },
              {
                "actions": [
                  "audit_adoption_denied"
                ]
              }
            ],
            "RECON_FOUND_LIVE": {
              "actions": [
                "record_remote_state"
              ]
            },
            "RECON_FOUND_PARTIAL": {
              "actions": [
                "record_remote_state"
              ]
            },
            "RECON_FOUND_FILLED": {
              "target": "#order.lifecycle.filled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_FOUND_CANCELLED": {
              "target": "#order.lifecycle.cancelled",
              "actions": [
                "adopt_recon"
              ]
            },
            "RECON_MISS": [
              {
                "target": "#order.lifecycle.cancelled",
                "guard": "second_consecutive_miss",
                "actions": [
                  "set_cancel_missing_remote"
                ]
              },
              {
                "target": "#order.lifecycle.untracked",
                "reenter": true,
                "actions": [
                  "bump_recon_misses"
                ]
              }
            ],
            "EXEC": {
              "actions": [
                "record_remote_state"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_unowned"
              ]
            },
            "CANCEL": {
              "actions": [
                "audit_command_refused_unowned"
              ]
            },
            "AMEND": {
              "actions": [
                "audit_command_refused_unowned"
              ]
            },
            "SEND": {
              "actions": [
                "audit_command_refused_unowned"
              ]
            },
            "VALIDATE": {
              "actions": [
                "audit_command_refused_unowned"
              ]
            }
          }
        },
        "held": {
          "entry": [
            "persist_event",
            "raise_critical_alert"
          ],
          "on": {
            "EXEC": {
              "actions": [
                "audit_reconcile_anomaly",
                "notify_protection_region"
              ]
            },
            "OPERATOR_RESOLVED": {
              "target": "#order.lifecycle.rejected",
              "actions": [
                "audit_operator_resolved"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_unowned"
              ]
            }
          }
        },
        "filled": {
          "type": "final",
          "entry": [
            "persist_event",
            "notify_protection_region",
            "emit_terminal"
          ],
          "tags": [
            "terminal"
          ],
          "on": {
            "EXEC": {
              "actions": [
                "audit_reconcile_anomaly",
                "notify_protection_region"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_terminal"
              ]
            }
          }
        },
        "cancelled": {
          "type": "final",
          "entry": [
            "persist_event",
            "notify_protection_region",
            "emit_terminal"
          ],
          "tags": [
            "terminal"
          ],
          "on": {
            "EXEC": {
              "actions": [
                "audit_reconcile_anomaly",
                "notify_protection_region"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_terminal"
              ]
            }
          }
        },
        "rejected": {
          "type": "final",
          "entry": [
            "persist_event",
            "emit_terminal"
          ],
          "tags": [
            "terminal"
          ],
          "on": {
            "EXEC": {
              "actions": [
                "audit_reconcile_anomaly",
                "notify_protection_region"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_terminal"
              ]
            }
          }
        },
        "expired": {
          "type": "final",
          "entry": [
            "persist_event",
            "notify_protection_region",
            "emit_terminal"
          ],
          "tags": [
            "terminal"
          ],
          "on": {
            "EXEC": {
              "actions": [
                "audit_reconcile_anomaly",
                "notify_protection_region"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_terminal"
              ]
            }
          }
        },
        "killed": {
          "type": "final",
          "entry": [
            "persist_event",
            "mark_halted_by_kill",
            "audit_kill",
            "issue_kill_cancel",
            "emit_terminal"
          ],
          "tags": [
            "terminal",
            "halted_by_kill"
          ],
          "on": {
            "EXEC": {
              "actions": [
                "audit_reconcile_anomaly",
                "notify_protection_region"
              ]
            },
            "KILL": {
              "actions": [
                "audit_kill_ignored_terminal"
              ]
            }
          }
        }
      },
      "on": {
        "KILL": {
          "target": "#order.lifecycle.killed"
        },
        "OPERATOR_RESOLVED": {
          "actions": [
            "audit_operator_command_refused"
          ]
        },
        "ADOPT": {
          "actions": [
            "audit_operator_command_refused"
          ]
        }
      }
    },
    "protection": {
      "initial": "not_required",
      "states": {
        "not_required": {
          "on": {
            "FIRST_FILL": {
              "target": "#order.protection.sl_pending"
            }
          }
        },
        "sl_pending": {
          "entry": [
            "arm_sl_deadline"
          ],
          "invoke": {
            "id": "attach_sl",
            "src": "attach_native_sl",
            "onDone": [
              {
                "target": "#order.protection.sl_present",
                "guard": "sl_attach_ok"
              },
              {
                "target": "#order.protection.sl_missing"
              }
            ],
            "onError": {
              "target": "#order.protection.sl_missing"
            }
          },
          "on": {
            "SL_DEADLINE": {
              "target": "#order.protection.sl_missing"
            }
          }
        },
        "sl_present": {
          "tags": [
            "protected"
          ],
          "on": {
            "SL_LOST": {
              "target": "#order.protection.sl_missing",
              "actions": [
                "record_sl_fact_ignored"
              ]
            }
          }
        },
        "sl_missing": {
          "tags": [
            "naked"
          ],
          "entry": [
            "raise_naked_position_alert",
            "request_fallback_sl"
          ],
          "on": {
            "SL_OBSERVED": [
              {
                "target": "#order.protection.sl_present",
                "guard": "sl_observed_ok"
              },
              {
                "actions": [
                  "record_sl_fact_ignored"
                ]
              }
            ]
          }
        }
      },
      "on": {
        "SL_OBSERVED": {
          "actions": [
            "record_sl_fact_ignored"
          ]
        },
        "SL_LOST": {
          "actions": [
            "record_sl_fact_ignored"
          ]
        },
        "FIRST_FILL": {
          "actions": [
            "record_sl_fact_ignored"
          ]
        },
        "SL_DEADLINE": {
          "actions": [
            "record_sl_fact_ignored"
          ]
        },
        "KILL": {
          "actions": [
            "audit_kill_protection_retained"
          ]
        }
      }
    }
  }
}
