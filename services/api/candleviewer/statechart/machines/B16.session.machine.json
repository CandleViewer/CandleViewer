{
  "id": "session",
  "version": 2,
  "strictConfig": true,
  "maxIterations": 500,
  "actionErrorPolicy": "rollback",
  "onUnhandled": "defer",
  "guardErrorPolicy": "raise",
  "strictTargets": true,
  "strict": true,
  "spawnBlockingTimeout": 5000,
  "type": "parallel",
  "on": {
    "LOGOUT": {
      "target": "#session.elevation.dead"
    },
    "ABSOLUTE_DEADLINE": {
      "target": "#session.elevation.dead"
    },
    "REVOKE": {
      "target": "#session.elevation.dead"
    }
  },
  "context": {
    "session_id": null,
    "user_id": null,
    "expires_at_us": 0,
    "idle_expires_at_us": 0,
    "refresh_expires_at_us": 0,
    "elevated_until_us": null,
    "mfa_satisfied": false,
    "revoke_reason": null,
    "elevated_classes": {},
    "step_up_failures": 0,
    "readonly_until_us": null,
    "idle_locked": false,
    "unlock_attempts": 0,
    "one_click_armed": null
  },
  "states": {
    "auth": {
      "initial": "pending_mfa",
      "on": {
        "UNLOCK_OK": {
          "actions": [
            "audit_ignored_request"
          ]
        },
        "UNLOCK_FAILED": {
          "actions": [
            "audit_ignored_request"
          ]
        },
        "IDLE_DEADLINE": {
          "actions": []
        }
      },
      "states": {
        "pending_mfa": {
          "on": {
            "MFA_OK": {
              "target": "#session.auth.active",
              "actions": [
                "mark_mfa_satisfied",
                "audit_login"
              ]
            },
            "MFA_FAILED": [
              {
                "target": "#session.auth.revoked",
                "guard": "mfa_attempts_exhausted",
                "actions": [
                  "set_revoke_locked"
                ]
              },
              {
                "actions": [
                  "bump_mfa_attempts",
                  "audit_mfa_failed"
                ]
              }
            ],
            "MFA_TIMEOUT": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_timeout"
              ]
            }
          }
        },
        "active": {
          "entry": [
            "stamp_idle_deadline"
          ],
          "on": {
            "REQUEST": {
              "target": "#session.auth.active",
              "reenter": true,
              "actions": [
                "stamp_idle_deadline"
              ]
            },
            "IDLE_DEADLINE": {
              "target": "#session.auth.idle_locked"
            },
            "ABSOLUTE_DEADLINE": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_expired"
              ]
            },
            "REVOKE": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_admin"
              ]
            },
            "LOGOUT": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_logout"
              ]
            }
          }
        },
        "idle_locked": {
          "tags": [
            "locked"
          ],
          "entry": [
            "mark_idle_locked",
            "clear_elevated",
            "disarm_one_click",
            "audit_idle_locked"
          ],
          "exit": [
            "clear_idle_locked"
          ],
          "on": {
            "UNLOCK_OK": {
              "target": "#session.auth.active",
              "actions": [
                "stamp_idle_deadline"
              ]
            },
            "UNLOCK_FAILED": [
              {
                "target": "#session.auth.revoked",
                "guard": "unlock_attempts_exhausted",
                "actions": [
                  "set_revoke_locked"
                ]
              },
              {
                "actions": [
                  "bump_unlock_attempts"
                ]
              }
            ],
            "REQUEST": {
              "actions": [
                "audit_ignored_request"
              ]
            },
            "ABSOLUTE_DEADLINE": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_expired"
              ]
            },
            "REVOKE": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_admin"
              ]
            },
            "LOGOUT": {
              "target": "#session.auth.revoked",
              "actions": [
                "set_revoke_logout"
              ]
            }
          }
        },
        "revoked": {
          "type": "final",
          "tags": [
            "terminal"
          ],
          "entry": [
            "audit_session_revoked",
            "broadcast_revocation"
          ]
        }
      }
    },
    "elevation": {
      "initial": "normal",
      "states": {
        "normal": {
          "tags": [
            "not_elevated"
          ],
          "always": {
            "target": "#session.elevation.dead",
            "guard": "session_revoked"
          },
          "on": {
            "STEP_UP_OK": [
              {
                "target": "#session.elevation.elevated",
                "guard": "session_active",
                "actions": [
                  "stamp_elevated_until",
                  "audit_step_up"
                ]
              },
              {
                "actions": [
                  "audit_ignored_request"
                ]
              }
            ],
            "STEP_UP_FAILED": [
              {
                "target": "#session.elevation.readonly_downgrade",
                "guard": "step_up_strikes_exhausted",
                "actions": [
                  "record_step_up_failure",
                  "audit_step_up_failed",
                  "audit_readonly_downgrade"
                ]
              },
              {
                "actions": [
                  "record_step_up_failure",
                  "audit_step_up_failed"
                ]
              }
            ],
            "ACTION_REQUEST": [
              {
                "actions": [
                  "audit_step_up_required"
                ]
              }
            ]
          }
        },
        "elevated": {
          "tags": [
            "elevated"
          ],
          "entry": [
            "schedule_elevation_deadline"
          ],
          "on": {
            "ELEVATION_DEADLINE": {
              "target": "#session.elevation.normal",
              "actions": [
                "clear_elevated"
              ]
            },
            "STEP_UP_OK": {
              "target": "#session.elevation.elevated",
              "reenter": true,
              "actions": [
                "stamp_elevated_until",
                "audit_step_up"
              ]
            },
            "STEP_UP_FAILED": [
              {
                "target": "#session.elevation.readonly_downgrade",
                "guard": "step_up_strikes_exhausted",
                "actions": [
                  "record_step_up_failure",
                  "audit_step_up_failed",
                  "audit_readonly_downgrade"
                ]
              },
              {
                "actions": [
                  "record_step_up_failure",
                  "audit_step_up_failed"
                ]
              }
            ],
            "ACTION_REQUEST": [
              {
                "guard": "grace_window_valid",
                "actions": [
                  "audit_grace_used"
                ]
              },
              {
                "actions": [
                  "audit_step_up_required"
                ]
              }
            ],
            "IDLE_DEADLINE": {
              "target": "#session.elevation.normal",
              "actions": [
                "clear_elevated"
              ]
            }
          }
        },
        "dead": {
          "type": "final"
        },
        "readonly_downgrade": {
          "tags": [
            "readonly"
          ],
          "entry": [
            "clear_elevated"
          ],
          "always": {
            "target": "#session.elevation.dead",
            "guard": "session_revoked"
          },
          "on": {
            "READONLY_EXPIRED": {
              "target": "#session.elevation.normal",
              "actions": [
                "clear_step_up_failures"
              ]
            }
          }
        }
      }
    }
  }
}
