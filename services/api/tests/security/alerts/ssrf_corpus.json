{
  "$comment": "E40-X01 (#1204) Part A: the webhook SSRF corpus, as data (the ruling on #1204, BQ-9). Threat model: docs/security/threat-models/e40-alerts.md section 5 (AL-E05, AL-S06, SR-E40-13); seed AC-AL-18; its shape test is test_ssrf_corpus_shape.py beside it, and E40-S03's egress policy runs every entry as a required check. Nothing here is ever sent: each entry is a target the policy decides on before any socket opens. An entry names its `class` (one of `classes`), its `url`, the resolver script it runs with (`via`: one list of answers per lookup, an empty list being a lookup that fails or answers nothing), the `attempt` it is judged on where it names one (each attempt resolves afresh), and its `expect`: a refusal reason, `permitted`, or `pinned` (one lookup, and the socket goes to `connect_to`). `order` gives the policy's steps; its address step lists the address classes in precedence, and an IPv6 address that embeds an IPv4 address (mapped, compatible, NAT64, 6to4, Teredo) is judged by every address it embeds. A host is compared after `name_normalisation`. Host names under `.example` (RFC 2606) are fixture names. The `public_stand_ins` (RFC 5737 documentation ranges) stand in for public addresses: the harness marks them global through an injected classifier, never through the policy, which refuses every non-global address outside the tailnet. 100.101.102.0/24 stands in for tailnet peers. The allow-list holds refused targets on purpose: a refused class wins over the allow-list.",
  "version": 2,
  "name_normalisation": "UTS 46 (IDNA) mapping to ASCII, then lower case, then one trailing dot removed; refused_names, the allow-list and the resolver scripts are keyed by the normalised name, and a host the mapping refuses is malformed_url",
  "order": [
    {
      "step": "url",
      "rule": "the scheme is https or http and the authority parses as one host, with no userinfo and no percent-encoding",
      "refuses": ["malformed_url", "userinfo", "scheme"]
    },
    {
      "step": "name",
      "rule": "the normalised host against refused_names, exact before suffix",
      "refuses": ["loopback", "metadata", "tailnet_service"]
    },
    {
      "step": "resolution",
      "rule": "an IP literal stands for itself; a name takes every answer of its lookup",
      "refuses": ["unresolvable"]
    },
    {
      "step": "address",
      "rule": "every address, by class in this precedence",
      "refuses": [
        "metadata",
        "loopback",
        "unspecified_address",
        "link_local",
        "private_address",
        "reserved_address",
        "tailnet_service",
        "host_service"
      ]
    },
    {
      "step": "scheme_for_address",
      "rule": "http only when every address is inside a tailnet CIDR",
      "refuses": ["scheme"]
    },
    {
      "step": "allow_list",
      "rule": "the scheme, host and port on the owner's allow-list",
      "refuses": ["not_on_allow_list"]
    },
    {
      "step": "connect",
      "rule": "no redirect is followed; the socket goes to the address that was checked",
      "refuses": ["redirect"]
    }
  ],
