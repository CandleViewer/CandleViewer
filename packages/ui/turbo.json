{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "tokens/**",
        "scripts/**",
        "contrast/**",
        "eslint-rules/**",
        ".storybook/**",
        "vitest.config.mjs",
        "package.json",
        "tsconfig.json",
        "tsup.config.ts",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.dom.json",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/packages/config/vitest.preset.mjs",
        "$TURBO_ROOT$/tools/contrast/**",
        "$TURBO_ROOT$/tools/style-dictionary/**"
      ]
    },
    "test:cov": {
      "tags": ["unit-frontend"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "tokens/**",
        "scripts/**",
        "contrast/**",
        "eslint-rules/**",
        ".storybook/**",
        "vitest.config.mjs",
        "package.json",
        "tsconfig.json",
        "tsup.config.ts",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.dom.json",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/packages/config/vitest.preset.mjs",
        "$TURBO_ROOT$/tools/contrast/**",
        "$TURBO_ROOT$/tools/style-dictionary/**"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.dom.json",
        "$TURBO_ROOT$/tools/style-dictionary/**"
      ]
    },
    "typecheck": {
      "tags": ["typecheck"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "eslint-rules/*.d.mts",
        "scripts/*.d.mts",
        "package.json",
        "$TURBO_ROOT$/tools/style-dictionary/formats/*.d.ts"
      ]
    }
  }
}
