{
  "name": "@candleviewer/ui",
  "version": "0.1.0",
  "private": true,
  "description": "CandleViewer design system: tokens, primitives, trading components. Depends on @candleviewer/protocol and @candleviewer/chart-engine only; never on apps/* (C-3.5).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "pnpm run build:tokens && tsup",
    "build:tokens": "node scripts/build-tokens.mjs",
    "contrast:gate": "node ../../tools/contrast/generate.mjs && node ../../tools/contrast/data-ink.mjs --check && node ../../tools/contrast/no-hue-alone.mjs",
    "contrast:data-ink": "node ../../tools/contrast/data-ink.mjs",
    "size": "echo \"@candleviewer/ui: size-limit wired alongside E05 components\"",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook -o storybook-static"
  },
  "devDependencies": {
    "@candleviewer/config": "workspace:*",
    "@candleviewer/protocol": "workspace:*",
    "@candleviewer/chart-engine": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "style-dictionary": "^5.6.0",
    "storybook": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/test": "^8.4.7"
  }
}
