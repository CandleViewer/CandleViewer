{
  "name": "@candleviewer/ui",
  "version": "0.1.0",
  "private": true,
  "description": "CandleViewer design system: tokens, primitives, trading components. Depends on @candleviewer/protocol and @candleviewer/chart-engine only; never on apps/* (C-3.5).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./components.css": "./dist/components.css",
    "./tokens.*.css": "./dist/tokens.*.css"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:perf": "vitest run --project perf",
    "build": "pnpm run build:tokens && pnpm run build:icons --check && tsup",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "contrast:gate": "node ../../tools/contrast/generate.mjs && node ../../tools/contrast/data-ink.mjs --check && node ../../tools/contrast/no-hue-alone.mjs",
    "contrast:data-ink": "node ../../tools/contrast/data-ink.mjs",
    "size": "echo \"@candleviewer/ui: size-limit wired alongside E05 components\"",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 -c .storybook --disable-telemetry --no-version-updates",
    "storybook:build": "storybook build -c .storybook -o storybook-static --disable-telemetry",
    "storybook:test": "vitest run --project storybook",
    "vr": "playwright test -c vr/playwright.config.ts",
    "vr:update": "playwright test -c vr/playwright.config.ts --update-snapshots=changed"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0"
  },
  "devDependencies": {
    "@candleviewer/config": "workspace:*",
    "@candleviewer/protocol": "workspace:*",
    "@candleviewer/chart-engine": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "style-dictionary": "^5.6.1",
    "esbuild": "0.25.12",
    "storybook": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.64.1"
  }
}
