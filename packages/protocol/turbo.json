{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "**/*.{yaml,json}",
        "scripts/**",
        "!**/*.md",
        "!.cache/**",
        "$TURBO_ROOT$/docs/plan/22-api-openapi.yaml",
        "$TURBO_ROOT$/docs/plan/23-ws-protocol.md",
        "$TURBO_ROOT$/docs/plan/ws-schema.json",
        "$TURBO_ROOT$/packages/config/prettier.config.mjs",
        "$TURBO_ROOT$/packages/fixtures/golden/bars/bar-model.schema.json",
        "$TURBO_ROOT$/packages/fixtures/golden/policy/rules.json",
        "$TURBO_ROOT$/prettier.config.mjs",
        "$TURBO_ROOT$/tools/gen/export_instrument_policy_corpus.py",
        "$TURBO_ROOT$/tools/gen/export_instrument_policy_rules.py"
      ],
      "outputs": [
        ".cache/generated-manifest.json",
        "src/generated/**",
        "$TURBO_ROOT$/docs/plan/ws-schema.json",
        "$TURBO_ROOT$/packages/fixtures/golden/policy/corpus.json",
        "$TURBO_ROOT$/packages/fixtures/golden/policy/rules.json",
        "$TURBO_ROOT$/services/api/candleviewer/ws/_generated/cvwb_layout.py"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "vitest.config.mjs",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.node.json",
        "$TURBO_ROOT$/packages/config/vitest.preset.mjs"
      ]
    },
    "test:cov": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "vitest.config.mjs",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json",
        "$TURBO_ROOT$/packages/config/tsconfig.node.json",
        "$TURBO_ROOT$/packages/config/vitest.preset.mjs"
      ]
    }
  }
}
