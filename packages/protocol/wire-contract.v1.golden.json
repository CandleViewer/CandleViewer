        "include_events": "boolean",
        "metrics": "array",
        "min_imbalance_volume": "string",
        "min_notional_usd": "string",
        "min_size": "string",
        "min_stack": "integer",
        "open_only": "boolean",
        "param": "string",
        "params": "object",
        "price_grouping": "integer",
        "rule_ids": "array",
        "session_anchor": "string",
        "split": "string",
        "status": "array",
        "symbols": "array",
        "throttle_ms": "integer",
        "time_bucket_ms": "integer",
        "unacked_only": "boolean",
        "value_area_pct": "number",
        "window_seconds": "integer"
      },
      "additional_properties": false
    },
    "sub#/properties/topics/items": {
      "required": ["ch"],
      "members": {"ch": "string", "opts": "object"},
      "additional_properties": false
    },
    "sub_ok": {"required": ["results"], "members": {"results": "array"}, "additional_properties": false},
    "sub_ok#/properties/results/items": {
