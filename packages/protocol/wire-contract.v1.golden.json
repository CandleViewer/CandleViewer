        "upstream_desync",
        "upstream_reconnect",
        "backpressure",
        "reconfigure",
        "instrument_revision",
        "replay_seek",
        "generation_swap",
        "history_repair"
      ]
    },
    "snap.meta.source": {"open": false, "values": ["live", "replay"]}
  },
  "bounds": {
    "common.subId": {"side": "response", "type": "string", "minLength": 1, "maxLength": 64},
    "ctl.metrics": {
      "side": "request",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "sub.indicator_options.from_seq": {"side": "request", "type": "integer", "minimum": 0},
    "sub.options.from_seq": {"side": "request", "type": "integer", "minimum": 0},
    "sub.options.metrics": {
      "side": "request",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "sub.options.rule_ids": {"side": "request", "type": "array", "maxItems": 100, "items": {"type": "string"}},
    "sub.options.status": {
      "side": "request",
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "sub.options.symbols": {
      "side": "request",
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {"type": "string"}
    },
    "sub_ok.results.sub_id": {"side": "response", "type": "string", "minLength": 1, "maxLength": 64}
  },
  "close_codes": {
    "gateway": [1000, 1001, 1002, 1009, 1011, 1013, 4400, 4401, 4403, 4429],
    "host_only": [1012],
    "reasons": {
      "normal": {"code": 1000, "reconnect": false},
      "heartbeat_timeout": {"code": 1001, "reconnect": true},
      "shutdown": {"code": 1001, "reconnect": true},
      "protocol_violation": {"code": 1002, "reconnect": false},
      "unsupported_protocol": {"code": 1002, "reconnect": false},
      "frame_too_big": {"code": 1009, "reconnect": false},
      "internal_error": {"code": 1011, "reconnect": true},
      "server_shedding_load": {"code": 1013, "reconnect": true},
      "bad_client": {"code": 4400, "reconnect": false},
      "auth_failed": {"code": 4401, "reconnect": true},
      "auth_timeout": {"code": 4401, "reconnect": true},
      "not_authenticated": {"code": 4401, "reconnect": true},
      "session_revoked": {"code": 4401, "reconnect": false},
      "token_expired": {"code": 4401, "reconnect": true},
      "mfa_enrollment_required": {"code": 4403, "reconnect": false},
