        "sub_id": "string"
      },
      "additional_properties": false
    },
    "sub": {
      "required": ["topics"],
      "members": {"replay_session_id": "null|string", "snapshot": "boolean", "topics": "array"},
      "additional_properties": false
    },
    "sub#/$defs/indicatorOptions": {
      "required": ["instances"],
      "members": {
        "coalesce": "boolean",
        "encoding": "string",
        "from_seq": "integer",
        "from_ts_ms": "integer",
        "history": "integer",
        "instances": "array",
        "throttle_ms": "integer"
      },
      "additional_properties": false
    },
    "sub#/$defs/options": {
      "required": [],
      "members": {
        "bar_type": "string",
        "cluster_tolerance_ticks": "integer",
        "cluster_window_ms": "integer",
        "coalesce": "boolean",
        "depth": "integer",
        "encoding": "string",
        "exchange_account_ids": "array",
        "from_seq": "integer",
        "from_ts_ms": "integer",
        "history": "integer",
