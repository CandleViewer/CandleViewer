{
  "contract": "cv.v1",
  "header": {
    "bytes": 24,
    "endianness": "little",
    "magic": "0x43565742",
    "fields": [
      {"name": "magic", "type": "u32", "offset": 0, "size": 4},
      {"name": "format_version", "type": "u8", "offset": 4, "size": 1},
      {"name": "body_kind", "type": "u8", "offset": 5, "size": 1},
      {"name": "flags", "type": "u8", "offset": 6, "size": 1},
      {"name": "price_scale", "type": "u8", "offset": 7, "size": 1},
      {"name": "qty_scale", "type": "u8", "offset": 8, "size": 1},
      {"name": "reserved", "type": "pad3", "offset": 9, "size": 3},
      {"name": "record_count", "type": "u32", "offset": 12, "size": 4},
      {"name": "ts_base_ms", "type": "u64", "offset": 16, "size": 8}
    ],
    "flags": ["estimated", "coalesced", "replay", "partial"]
  },
  "body_kinds": {
    "1": {
      "name": "book_snapshot",
      "format_version": 1,
      "length_rule": "min",
      "record_stride": 17,
      "record": [
        {"name": "side", "type": "u8", "offset": 0, "size": 1, "enum": [0, 1]},
        {"name": "price", "type": "i64", "offset": 1, "size": 8},
        {"name": "size", "type": "u64", "offset": 9, "size": 8}
      ],
      "trailer": {
        "size": 16,
        "fields": [
          {"name": "xu", "type": "u64", "offset": 0, "size": 8},
          {"name": "xseq", "type": "u64", "offset": 8, "size": 8}
        ]
      }
    },
    "2": {
      "name": "book_delta",
      "format_version": 1,
      "length_rule": "min",
      "record_stride": 17,
      "record": [
        {"name": "side", "type": "u8", "offset": 0, "size": 1, "enum": [0, 1]},
        {"name": "price", "type": "i64", "offset": 1, "size": 8},
        {"name": "size", "type": "u64", "offset": 9, "size": 8}
      ]
    },
    "3": {
      "name": "trades",
      "format_version": 1,
      "length_rule": "min",
      "record_stride": 22,
      "record": [
        {"name": "ts_offset_ms", "type": "u32", "offset": 0, "size": 4},
        {"name": "price", "type": "i64", "offset": 4, "size": 8},
        {"name": "size", "type": "u64", "offset": 12, "size": 8},
        {"name": "side", "type": "u8", "offset": 20, "size": 1, "enum": [0, 1]},
        {"name": "flags", "type": "u8", "offset": 21, "size": 1}
      ]
    },
    "4": {
      "name": "bars",
      "format_version": 2,
      "length_rule": "exact",
      "record_stride": 85,
      "record": [
        {"name": "generation", "type": "u64", "offset": 0, "size": 8},
        {"name": "index", "type": "u64", "offset": 8, "size": 8},
        {"name": "ts_offset_ms", "type": "u32", "offset": 16, "size": 4},
        {"name": "open", "type": "i64", "offset": 20, "size": 8},
        {"name": "high", "type": "i64", "offset": 28, "size": 8},
        {"name": "low", "type": "i64", "offset": 36, "size": 8},
        {"name": "close", "type": "i64", "offset": 44, "size": 8},
        {"name": "volume", "type": "u64", "offset": 52, "size": 8},
        {"name": "turnover", "type": "u64", "offset": 60, "size": 8},
        {"name": "trades", "type": "u32", "offset": 68, "size": 4},
        {"name": "delta", "type": "i64", "offset": 72, "size": 8},
        {"name": "flags", "type": "u8", "offset": 80, "size": 1},
        {"name": "reserved", "type": "pad4", "offset": 81, "size": 4}
      ]
    },
    "5": {
      "name": "footprint",
      "format_version": 2,
      "length_rule": "min",
      "record_stride": 33,
      "record": [
        {"name": "price", "type": "i64", "offset": 0, "size": 8},
        {"name": "bid_volume", "type": "u64", "offset": 8, "size": 8},
        {"name": "ask_volume", "type": "u64", "offset": 16, "size": 8},
        {"name": "trades", "type": "u32", "offset": 24, "size": 4},
        {"name": "flags", "type": "u8", "offset": 28, "size": 1},
        {"name": "reserved", "type": "pad4", "offset": 29, "size": 4}
      ],
      "group_prefix": {
        "size": 28,
        "fields": [
          {"name": "generation", "type": "u64", "offset": 0, "size": 8},
          {"name": "index", "type": "u64", "offset": 8, "size": 8},
          {"name": "ts_offset_ms", "type": "u32", "offset": 16, "size": 4},
          {"name": "cell_count", "type": "u32", "offset": 20, "size": 4, "count": true},
          {"name": "flags", "type": "u8", "offset": 24, "size": 1},
          {"name": "reserved", "type": "pad3", "offset": 25, "size": 3}
        ]
      }
    },
    "6": {
      "name": "heatmap_column",
      "format_version": 1,
      "length_rule": "min",
      "record_stride": 16,
      "record": [
        {"name": "bid_size", "type": "u64", "offset": 0, "size": 8},
        {"name": "ask_size", "type": "u64", "offset": 8, "size": 8}
      ],
      "body_prefix": {
        "size": 24,
        "fields": [
          {"name": "ts_offset_ms", "type": "u32", "offset": 0, "size": 4},
          {"name": "price_min", "type": "i64", "offset": 4, "size": 8},
          {"name": "price_step", "type": "i64", "offset": 12, "size": 8},
          {"name": "row_count", "type": "u32", "offset": 20, "size": 4, "count": true}
        ]
      }
    }
  },
  "envelope": {
    "frame_types": [
      "hello",
      "welcome",
      "auth",
      "auth_ok",
      "sub",
      "sub_ok",
      "unsub",
      "unsub_ok",
      "snap",
      "d",
      "resync",
      "revoked",
      "permission_change",
      "ping",
      "pong",
      "err",
      "ctl",
      "ctl_ok",
      "bye"
    ],
    "encodings": ["j", "b", "b64"],
    "members": {
      "ch": "string",
      "e": "string",
      "id": "string",
      "meta": "object",
      "p": "any",
      "rs": "string",
      "s": "integer|null",
      "sp": "string",
      "t": "string",
      "ts": "integer",
      "wt": "integer"
    },
    "required": ["t"],
    "per_type_required": {"d": ["ch", "p", "s", "ts"], "snap": ["ch", "p", "s", "ts"]},
    "per_type_properties": {"d": {"s": "integer"}},
    "additional_properties": false
  },
  "control_frames": {
    "auth": {
      "required": ["access_token"],
      "members": {"access_token": "string", "environments": "array"},
      "additional_properties": false
    },
    "auth_ok": {
      "required": ["account_scope", "permissions", "roles", "session_id", "token_expires_at_ms", "user_id"],
