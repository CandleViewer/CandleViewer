  "enums": {
    "welcome.encoding": {"open": false, "values": ["msgpack", "json"]},
    "auth_ok.roles": {"open": false, "values": ["owner", "manager", "viewer"]},
    "permission_change.roles": {"open": false, "values": ["owner", "manager", "viewer"]},
