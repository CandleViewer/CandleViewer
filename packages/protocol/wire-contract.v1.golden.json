        "close": "boolean",
        "code": "string",
        "field": "string",
        "message": "string",
        "request_id": "string",
        "retryable": "boolean"
      },
      "additional_properties": false
    },
    "common#/$defs/indicatorInstance": {
      "required": ["indicator"],
      "members": {"indicator": "string", "params": "object"},
      "additional_properties": false
    },
    "ctl": {
      "required": [],
      "members": {
        "coalesce": "boolean",
        "depth": "integer",
        "instances": "array",
        "metrics": "array",
        "min_size": "string",
        "paused": "boolean",
        "price_grouping": "integer",
        "throttle_ms": "integer",
        "time_bucket_ms": "integer"
      },
      "additional_properties": false,
      "min_properties": 1
    },
    "ctl_ok": {
      "required": ["effective"],
      "members": {"effective": "object", "resnapshot": "boolean", "sub_id": "string"},
      "additional_properties": false
    },
    "heartbeat": {
      "required": [],
      "members": {"client_ms": "integer", "rtt_hint_ms": "integer", "server_ms": "integer"},
      "additional_properties": false
    },
    "hello": {
      "required": ["client", "client_version", "protocol"],
