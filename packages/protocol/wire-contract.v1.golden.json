        "capabilities": "array",
        "client": "string",
        "client_version": "string",
        "clock_ms": "integer",
        "encodings": "array",
        "locale": "string",
        "protocol": "string",
        "shell": "string"
      },
      "additional_properties": false
    },
    "permission_change": {
      "required": ["account_scope", "permissions", "roles", "user_id"],
      "members": {"account_scope": "array", "permissions": "array", "roles": "array", "user_id": "string"},
      "additional_properties": false
    },
    "resync": {
      "required": ["reason"],
      "members": {"last_seq": "integer|null", "reason": "string", "sub_id": "string"},
      "additional_properties": false
