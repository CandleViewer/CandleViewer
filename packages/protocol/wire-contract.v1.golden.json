        "permissions": "array",
        "roles": "array",
        "session_id": "string",
        "token_expires_at_ms": "integer",
        "user_id": "string",
        "username": "string"
      },
      "additional_properties": false
    },
    "bye": {
      "required": ["code", "message", "reason"],
      "members": {
        "code": "integer",
        "hint": "object",
        "message": "string",
        "reason": "string",
        "reconnect": "boolean",
        "retry_after_ms": "integer"
      },
      "additional_properties": false
    },
    "bye#/properties/hint": {
      "required": [],
      "members": {"most_expensive_topics": "array"},
      "additional_properties": false
    },
    "common#/$defs/error": {
      "required": ["code", "message"],
