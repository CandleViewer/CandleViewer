      "id": "two-global-commands",
      "about": "Two Global commands are always live together.",
      "bindings": [{ "action": "global.cheatsheet", "keys": "Ctrl+Shift+H" }],
      "expect": {
        "conflict": [
          {
            "field": "bindings[0].keys",
            "action": "global.cheatsheet",
            "other": "global.toggle_high_contrast"
          },
          {
            "field": "bindings",
            "action": "global.toggle_high_contrast",
            "other": "global.cheatsheet"
          }
        ]
      }
    },
    {
      "id": "undeclared-shadow",
      "about": "A view command on a Global key it does not declare it shadows.",
      "bindings": [{ "action": "workspace.save_as", "keys": "/" }],
      "expect": {
        "conflict": [
          {
            "field": "bindings[0].keys",
            "action": "workspace.save_as",
            "other": "global.symbol_search"
          },
          { "field": "bindings", "action": "global.symbol_search", "other": "workspace.save_as" }
        ]
      }
    },
    {
      "id": "flags-left-out",
      "about": "requires_arm and confirm left out take the derived values.",
      "bindings": [{ "action": "ticket.submit", "keys": "Ctrl+Enter" }],
      "expect": { "accepted": { "rewritten": [], "stored": { "ticket.submit": "Ctrl+Enter" } } }
    },
    {
      "id": "arm-rewritten-both-ways",
      "about": "A wrong requires_arm is rewritten either way, in body order.",
      "bindings": [
        { "action": "ticket.submit", "keys": "Ctrl+Enter", "requires_arm": false },
        { "action": "dom.cancel_all", "keys": "Ctrl+Shift+X", "requires_arm": true },
        { "action": "chart.footprint_toggle", "keys": "F", "requires_arm": false, "confirm": false }
      ],
      "expect": { "accepted": { "rewritten": ["ticket.submit", "dom.cancel_all"] } }
    },
    {
      "id": "confirm-rewritten",
      "about": "A wrong confirm is rewritten either way.",
      "bindings": [
        { "action": "positions.close", "keys": "Ctrl+W", "confirm": false },
        { "action": "chart.undo", "keys": "Ctrl+Z", "confirm": true }
      ],
      "expect": { "accepted": { "rewritten": ["positions.close", "chart.undo"] } }
    },
    {
      "id": "rewritten-once",
      "about": "An action whose both flags are wrong is named once.",
      "bindings": [
        { "action": "ticket.submit", "keys": "Ctrl+Enter", "requires_arm": false, "confirm": false }
      ],
      "expect": { "accepted": { "rewritten": ["ticket.submit"] } }
    },
    {
      "id": "right-flags-not-rewritten",
      "about": "Flags that match the derived values are no rewrite.",
      "bindings": [
        {
          "action": "dom.market_click",
          "keys": "Ctrl+click",
          "requires_arm": true,
          "confirm": false
        },
        {
          "action": "positions.close_all",
          "keys": "Ctrl+Shift+W",
          "requires_arm": false,
          "confirm": true
        }
      ],
      "expect": { "accepted": { "rewritten": [] } }
    }
  ]
}
