{
  "name": "@candleviewer/fixtures",
  "version": "0.1.0",
  "private": true,
  "description": "Recorded, redacted Bybit fixtures + golden outputs, shared by TS and Python test suites. Never live-exchange data (C-13.5).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./e2e": "./src/e2e/index.ts",
    "./e2e/stubs": "./src/e2e/stubs.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && node ./scripts/verify.mjs && vitest run",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "echo \"@candleviewer/fixtures: nothing to build\"",
    "size": "echo \"@candleviewer/fixtures: no bundle\"",
    "verify": "node ./scripts/verify.mjs"
  },
  "devDependencies": {
    "@candleviewer/config": "workspace:*",
    "globals": "^15.14.0",
    "vitest": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.17.0",
    "@candleviewer/protocol": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
